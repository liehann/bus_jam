<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions (no UI): adb hooks for testing. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- adb shell am broadcast -a com.phloots.crittercafe.RESET_INTROS -p com.phloots.crittercafe
             Forgets which mechanic intro cards were shown. The DUMP permission limits senders to the shell. -->
        <receiver
            android:name=".debug.ResetIntrosReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.phloots.crittercafe.RESET_INTROS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
